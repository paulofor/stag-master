{
  "name": "stag-desktop",
  "version": "0.4.44",
  "description": "STAG Plus: assistente desktop Windows para programação, integrado ao Codex App Server.",
  "private": true,
  "type": "module",
  "main": "dist/main/index.cjs",
  "author": "Paulo Forestieri",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:desktop": "node scripts/test-desktop.mjs",
    "test:codex": "node scripts/smoke-codex.mjs",
    "test:video": "node scripts/test-video.mjs",
    "test:windows": "node scripts/test-windows.mjs",
    "test:sqlserver": "node scripts/test-sqlserver.mjs",
    "test:server:config": "node --test server/test/config.test.mjs",
    "test:server": "npm run test:server:config && node server/test/run.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run test:video && npm run test:codex && npm run test:e2e",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "lucide-react": "1.49.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tedious": "20.3.3",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "build": {
    "appId": "io.stag.desktop",
    "productName": "STAG Plus",
    "copyright": "Desenvolvido por: Paulo Forestieri",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".local/media",
        "to": "media"
      },
      {
        "from": ".local/codex",
        "to": "codex"
      },
      {
        "from": "native",
        "to": "native"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "STAG-Plus-${version}-Windows-${arch}-Setup.${ext}"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "@openai/codex": "0.160.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
